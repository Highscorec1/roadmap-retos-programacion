private fun funcionReci( nombre1: String? = "", nombre2: String? = ""): Int{
    
    println()
    println("Ejercicio Adicional segunda forma usando when") 
    
    var contador = 0
    
    for (num in 1..100){
       
        
         
        when{
            num % 5 == 0 && num % 3 == 0 -> println(nombre1 + " " + nombre2)
